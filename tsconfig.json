{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/*/src",
    "scripts",
    "supabase/functions/_shared",
    "apps/worker-ia/src"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions/_shared/supabase.ts",
    "supabase/functions/_shared/canais/webpush.ts"
  ]
}